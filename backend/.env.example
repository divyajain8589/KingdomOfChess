# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kingdom_chess
# Long random string; used to sign the auth JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400
PORT=4000
# Browser origin of the Next.js app (CORS + Socket.IO)
FRONTEND_URL=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false
