# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kingdom_chess
# Long random string; used to sign the auth JWT. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400
PORT=4000
# Browser origin of the Next.js app (CORS + Socket.IO)
FRONTEND_URL=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Number of reverse proxies (load balancer, nginx) in front of the API; used for per-IP rate limits
TRUST_PROXY=0
