# Browser-facing URL of the NestJS API (also used for Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show the "Try a demo account" quick sign-in buttons on /login (default off).
# Only for local/demo stacks; leave unset for real deployments. Inlined at build time, so rebuild after changing.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
